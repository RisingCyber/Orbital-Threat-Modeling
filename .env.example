# Copy to .env and fill in for local development. Never commit the real .env file.

# Required in production (config.py refuses to start without it outside debug mode).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SPARTA_SECRET_KEY=

# development | production
SPARTA_ENV=development

# Set to 0 only for plain-HTTP local testing. Leave at 1 (default) behind TLS.
SPARTA_HTTPS=1

# Optional. If set, system pages will include an AI-written analyst narrative
# (see app/ai_assist.py). The app works fully without this.
ANTHROPIC_API_KEY=

# Optional. Defaults to a local SQLite file under instance/.
# SPARTA_DATABASE_URL=postgresql://user:pass@localhost/sparta
